; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="MadRealm"
run/main_scene="res://scenes/world/Dungeon.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

EventBus="*res://scripts/Core/EventBus.cs"
GameManager="*res://scripts/Core/GameManager.cs"
BulletPool="*res://scripts/Core/ObjectPool.cs"

[dotnet]

project/assembly_name="MadRealm"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerBullet"
2d_physics/layer_5="EnemyBullet"
